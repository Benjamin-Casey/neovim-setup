use std::fmt;

use color_eyre::Result;
use crossterm::event::{self, KeyCode};
use ratatui::{
    layout::{
        Constraint::{self},
        Layout, Rect,
    },
    style::{Color, Style},
    widgets::{Block, Clear, List, ListState, Paragraph, Tabs},
    DefaultTerminal, Frame,
};
use ratatui_textarea::TextArea;
use reqwest::Client;
use serde_json::Value;
use tokio::runtime::Runtime;

fn main() -> Result<()> {
    color_eyre::install()?;
    ratatui::run(|terminal| App::new().run(terminal))
}

enum InputMode {
    Normal,
    Editing,
}

impl fmt::Display for InputMode {
    fn fmt(&self, f: &mut fmt::Formatter) -> fmt::Result {
        match self {
            InputMode::Normal => write!(f, "Normal"),
            InputMode::Editing => write!(f, "Editing"),
        }
    }
}

enum RequestMethods {
    GET,
    POST,
    PUT,
    DELETE,
}

impl fmt::Display for RequestMethods {
    fn fmt(&self, f: &mut fmt::Formatter) -> fmt::Result {
        match self {
            RequestMethods::GET => write!(f, "GET"),
            RequestMethods::POST => write!(f, "POST"),
            RequestMethods::PUT => write!(f, "PUT"),
            RequestMethods::DELETE => write!(f, "DELETE"),
        }
    }
}

struct App<'a> {
    input_mode: InputMode,
    selected_method: RequestMethods,
    editing_url: bool,
    method_list_open: bool,
    method_list_state: ListState,
    url: String,
    url_cursor_index: usize,
    url_textarea: TextArea<'a>,
    api_client: Client,
    awaiting_response: bool,
}

impl< 'a> App< 'a> {
    fn new() -> Self {
        let mut method_list_state = ListState::default();
        method_list_state.select(Some(0));

        Self {
            input_mode: InputMode::Normal,
            selected_method: RequestMethods::GET,
            editing_url: false,
            method_list_open: false,
            method_list_state,
            url: String::new(),
            url_cursor_index: 0,
            url_textarea: TextArea::default(),
            api_client: Client::new(),
            awaiting_response: false,
        }
    }

    fn run(&mut self, terminal: &mut DefaultTerminal) -> Result<()> {
        loop {
            terminal.draw(|frame| self.render(frame))?;

            if let Some(key) = event::read()?.as_key_press_event() {
                match self.input_mode {
                    InputMode::Normal => {
                        if self.method_list_open {
                            match key.code {
                                KeyCode::Up | KeyCode::Char('k') => {
                                    self.method_list_state.select_previous();
                                }

                                KeyCode::Down | KeyCode::Char('j') => {
                                    self.method_list_state.select_next();
                                }

                                KeyCode::Enter => {
                                    self.select_method();
                                }

                                KeyCode::Esc | KeyCode::Char('q') => {
                                    self.method_list_open = false;
                                }

                                _ => {}
                            }

                            continue;
                        }

                        if self.editing_url {
                            match key.code {
                                // Don't allow new line
                                KeyCode::Esc | KeyCode::Enter => {
                                    self.editing_url = false;
                                }
                                KeyCode::Enter => {
                                    let url = self.get_url(true);
                                    self.awaiting_response = true;
                                    // Render the updated state before blocking on the request.
                                    terminal.draw(|frame| self.render(frame))?;

                                    let runtime = Runtime::new()?;

                                    match self.selected_method {
                                        RequestMethods::GET => {
                                            self.get_request(&self.api_client, url);
                                        }
                                        RequestMethods::POST => {
                                            // TODO: get potential request body from somewhere
                                            match runtime.block_on(self.post_request(&self.api_client, None)) {
                                                Ok(body) => println!("{body}"),
                                                Err(error) => eprintln!("Request failed: {error}"),
                                            }
                                        }
                                        RequestMethods::PUT => {
                                        }
                                        RequestMethods::DELETE => {
                                        }
                                    }

                                    self.awaiting_response = false;
                                    // Redraw after the request completes.
                                    terminal.draw(|frame| self.render(frame))?;
                                }

                                // TODO: don't allow pasting multiple lines
                                _ => {
                                    self.url_textarea.input(key);
                                }
                            }
                            continue;
                        }

                        // Select 'modes'
                        match key.code {
                            // Widget select
                            KeyCode::Char('M') => {
                                self.open_method_list();
                            }
                            KeyCode::Char('U') => {
                                // TODO
                                self.edit_url();
                            }
                            // Debug
                            KeyCode::Char('T') => {
                                let url = self.get_url(true);
                                let runtime = Runtime::new()?;

                                self.awaiting_response = true;

                                // Render the updated state before blocking on the request.
                                terminal.draw(|frame| self.render(frame))?;

                                match runtime.block_on(self.post_request(&self.api_client, None)) {
                                    Ok(body) => println!("{body}"),
                                    Err(error) => eprintln!("Request failed: {error}"),
                                }

                                self.awaiting_response = false;
                                // Redraw after the request completes.
                                terminal.draw(|frame| self.render(frame))?;
                            }

                            KeyCode::Char('q') | KeyCode::Esc => {
                                // TODO: confirmation modal
                                return Ok(());
                            }

                            _ => {}
                        }
                    }

                    InputMode::Editing => {}
                }
            }
        }
    }

    // TODO: replace?
    fn edit_url(&mut self) {
        self.editing_url = true;
    }

    fn get_url(&self, add_http_prefix: bool) -> String {
        let mut url = self
            .url_textarea
            .lines()
            .first()
            .cloned()
            .unwrap_or_default()
            .trim()
            .to_owned();

        if add_http_prefix
            && !url.starts_with("http://")
            && !url.starts_with("https://")
        {
            url.insert_str(0, "http://");
        }

        url
    }

    async fn get_request(&self, client: &Client, url: String) -> Result<String, reqwest::Error> {
        let response = client.get(url)
            .send()
            .await?
            .text()
            .await?;

        Ok(response)
    }

    async fn post_request(&self, client: &Client, body: Option<&Value>) -> Result<String, reqwest::Error> {
        let request = client.post("http://127.0.0.1:8000/api/message");

        let response = match body {
            Some(json_body) => request.json(json_body).send().await?,
            _ => request.send().await?,
        };

        let response_body = response.text().await?;

        Ok(response_body)
    }

    fn put_request(&self) {}
    fn delete_request(&self) {}

    fn open_method_list(&mut self) {
        self.method_list_open = true;

        let selected_index = match self.selected_method {
            RequestMethods::GET => 0,
            RequestMethods::POST => 1,
            RequestMethods::PUT => 2,
            RequestMethods::DELETE => 3,
        };

        self.method_list_state.select(Some(selected_index));
    }

    fn select_method(&mut self) {
        if let Some(index) = self.method_list_state.selected() {
            self.selected_method = match index {
                0 => RequestMethods::GET,
                1 => RequestMethods::POST,
                2 => RequestMethods::PUT,
                3 => RequestMethods::DELETE,
                _ => return,
            };

            self.method_list_open = false;
        }
    }

    // Not needed if using textarea
    fn enter_char(&mut self, new_char: char) {
        self.url.insert(self.url_cursor_index, new_char);
    }

    fn move_cursor_left(&mut self) {
        if self.url_cursor_index > 0 {
            self.url_cursor_index -= 1;
        }
    }
    fn move_cursor_right(&mut self) {
        if self.url_cursor_index < self.url.len() {
            self.url_cursor_index += 1;
        }
    }
    fn backspace_char(&mut self) {
        if self.url_cursor_index > 0 {

        }
    }
    fn delete_char(&mut self) {}

    fn render_methods(&mut self, frame: &mut Frame, area: Rect) {
        let selected_method =
            Paragraph::new(format!(" {}", self.selected_method))
                .block(Block::bordered().title("Method"));

        frame.render_widget(selected_method, area);

        if !self.method_list_open {
            return;
        }

        let method_strings = [
            RequestMethods::GET.to_string(),
            RequestMethods::POST.to_string(),
            RequestMethods::PUT.to_string(),
            RequestMethods::DELETE.to_string(),
        ];

        // Place the popup directly below the method block.
        let popup_area = Rect::new(
            area.x,
            area.y,
            area.width,
            6,  // Length of method_strings list + 2 for borders
        );

        frame.render_widget(Clear, popup_area);

        let list = List::new(method_strings)
            .style(Style::default().fg(Color::White))
            .highlight_style(
                Style::default()
                    .fg(Color::Black)
                    .bg(Color::Indexed(104)),
            )
            .highlight_symbol("> ")
            .block(
                Block::bordered()
                    .title("Select method")
                    .border_style(Style::default().fg(Color::Indexed(104)))
            );

        frame.render_stateful_widget(
            list,
            popup_area,
            &mut self.method_list_state,
        );
    }

    fn render_tabs(&self, frame: &mut Frame, area: Rect, selected_tab: usize) {
        let tabs = Tabs::new(["Tab1", "Tab2", "Tab3"])
            .padding(" ", " ")
            .highlight_style(Style::default().bold())
            .select(selected_tab);

        frame.render_widget(tabs, area);
    }

    fn render_help(&self, frame: &mut Frame, area: Rect) {
        let key_help = if self.awaiting_response {
            "Awaiting response..."
        } else {
            "M: select method    U: edit url    Esc/q: exit"
        };

        let mode = Paragraph::new(format!(" {}    {}", self.input_mode, key_help));
        frame.render_widget(mode, area);
    }

    fn render(&mut self, frame: &mut Frame) {
        let [top, bottom, help] = Layout::vertical([
            Constraint::Length(3),
            Constraint::Fill(1),
            Constraint::Length(3),
        ])
        .areas(
            frame.area().centered(
                Constraint::Percentage(80),
                Constraint::Percentage(90),
            ),
        );

        let [settings, _response] = Layout::vertical([
            Constraint::Fill(1),
            Constraint::Fill(1),
        ])
        .areas(bottom);

        let [method_area, url_area] =
            Layout::horizontal(Constraint::from_percentages([25, 75]))
                .areas(top);

        let url_block_color = if self.editing_url { Color::Indexed(104) } else { Color::White };
        let url_block = Block::bordered().title("URL").style(url_block_color);
        // let url_widget = TextArea::default();
        self.url_textarea.set_block(url_block);

        frame.render_widget(&self.url_textarea, url_area);

        self.render_tabs(frame, settings, 0);

        self.render_methods(frame, method_area);
        self.render_help(frame, help);
    }
}

